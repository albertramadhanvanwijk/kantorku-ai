# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kantorku_ai

# Redis
REDIS_URL=redis://localhost:6379

# 9Router (AI gateway) — Phase 2+
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=https://api.9router.example
NINE_ROUTER_DEFAULT_MODEL=

# Object storage — local adapter by default (Phase 0)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_DIR=./storage

# Auth
AUTH_SECRET=change-me-to-a-secure-random-string-min-32-chars
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# App settings
DEFAULT_TIMEZONE=Asia/Jakarta
MAX_UPLOAD_MB=25

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000
